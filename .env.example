# ── Gauge ──────────────────────────────────────────────────────────────────
# Copy to `.env` (or just set the variables in your shell / app Settings UI).
#
# Twelve Data (FREE tier) unlocks XAUUSD, XAGUSD, indices, stocks and crypto
# from a single source. Get a key in ~10 seconds: https://twelvedata.com/pricing
# Without it, crypto falls back to Binance (no key) and everything else uses
# Yahoo / Stooq / a clearly-labelled simulator.
TWELVEDATA_API_KEY=

# Optional: HTTP port (default 4317)
PORT=4317

# Optional: disable no-key providers
# YAHOO_ENABLED=true
# STOOQ_ENABLED=true

# Optional: default refresh interval in seconds shown in the UI
REFRESH_SECONDS=60

# Optional: strength ratio that turns Buy/Sell into Strong Buy/Strong Sell
# (net buy-sell votes / total indicators). Default 0.25
STRONG_RATIO=0.25
